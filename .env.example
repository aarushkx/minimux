# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# BullMQ / Upstash Redis
UPSTASH_REDIS_URL=rediss://default:PASSWORD@YOUR-ENDPOINT.upstash.io:6379

# Neon Object Storage (filled by: neon deploy && neon env pull)
# These use standard AWS S3 environment variable names.
STORAGE_BUCKET=video-media
AWS_ACCESS_KEY_ID=your-neon-object-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-object-storage-secret
AWS_ENDPOINT_URL_S3=https://your-neon-s3-endpoint
AWS_REGION=us-east-2

# GitHub workflow dispatcher (server-side only)
GITHUB_OWNER=your-github-username
GITHUB_REPO=mini-mux-pipeline
GITHUB_WORKFLOW_FILE=transcode.yml
GITHUB_REF=main
GITHUB_TOKEN=github_pat_xxx

# Optional public UI settings
NEXT_PUBLIC_MAX_UPLOAD_MB=500
